# manage.py defaults to development. Environment files are not loaded automatically.
DJANGO_SETTINGS_MODULE=config.settings.development
TRACE_STORAGE_ROOT=./storage
TRACE_LOG_LEVEL=INFO
# Production: generate a private random secret of at least 50 characters.
# DJANGO_SETTINGS_MODULE=config.settings.production
# TRACE_SECRET_KEY=
# TRACE_ALLOWED_HOSTS=trace.example.internal
# TRACE_CSRF_TRUSTED_ORIGINS=https://trace.example.internal
# SQLite is the only supported database; its path follows TRACE_STORAGE_ROOT.

# Private evidence limits; types are identified from content. ZIP is opt-in.
TRACE_EVIDENCE_MAX_BYTES=52428800
TRACE_EVIDENCE_ALLOWED_TYPES=png,jpeg,pdf,text,pcap
TRACE_EVIDENCE_IMAGE_PIXELS=12000000
TRACE_EVIDENCE_IMAGE_SIDE=8192

# Optional editor-presence heartbeats; content version checks always apply.
TRACE_EDITOR_PRESENCE_ENABLED=1

# Report budgets; raise only within reviewed renderer ceilings.
TRACE_REPORT_MAX_FINDINGS=200
TRACE_REPORT_MAX_TESTS=1000
TRACE_REPORT_MAX_EVIDENCE=500
TRACE_REPORT_MAX_IMAGES=20
TRACE_REPORT_MAX_IMAGE_BYTES=8388608
TRACE_REPORT_MAX_SNAPSHOT_BYTES=16777216
TRACE_REPORT_MAX_ARTIFACT_BYTES=104857600
TRACE_REPORT_RENDER_TIMEOUT=90
# macOS Homebrew: usually /opt/homebrew/lib; Intel installations may use /usr/local/lib.
# TRACE_REPORT_WEASYPRINT_DLL_DIRECTORIES=/opt/homebrew/lib

# Private audit/revision history: operator cleanup only; 0 disables cleanup.
TRACE_AUDIT_RETENTION_DAYS=365
TRACE_AUDIT_MAX_EVENT_BYTES=2097152
TRACE_AUDIT_EXPORT_LIMIT=10000
TRACE_AUDIT_EXPORT_MAX_BYTES=33554432

# Optional PostgreSQL; SQLite remains the default. See docs/postgresql.md.
# TRACE_DB_ENGINE=postgresql
# TRACE_DB_NAME=trace
# TRACE_DB_USER=trace
# TRACE_DB_PASSWORD=
# TRACE_DB_HOST=127.0.0.1
# TRACE_DB_PORT=5432
# TRACE_DB_SSLMODE=verify-full
# Production proxy: one exact trusted IP; startup clears untrusted headers.
# TRACE_TRUST_PROXY=1
# TRACE_PROXY_IP=127.0.0.1
