# The standard nginx entrypoint substitutes only supplied environment variables.
# No customer files or application private storage are mounted into this proxy.
log_format trace_min '$time_iso8601 $status $body_bytes_sent';
limit_req_zone $binary_remote_addr zone=trace_login:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=trace_clients:10m;
limit_conn_zone $server_name zone=trace_total:10m;
limit_req_zone $binary_remote_addr zone=trace_requests:10m rate=5r/s;
server {
    listen 443 ssl;
    server_name ${TRACE_PROXY_SERVER_NAME};
    ssl_certificate /etc/nginx/tls/trace.crt;
    ssl_certificate_key /etc/nginx/tls/trace.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/access.log trace_min;
    client_body_timeout 30s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    send_timeout 60s;
    limit_conn trace_clients 8;
    limit_conn trace_total 32;
    limit_conn_status 429;
    limit_req zone=trace_requests burst=20 nodelay;
    client_max_body_size 64m;
    limit_req_status 429;
    location ~ ^/(accounts/login/|admin/login/)$ {
        limit_req zone=trace_login burst=10 nodelay;
        proxy_pass http://trace:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        proxy_pass http://trace:8000;
        proxy_read_timeout 120s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
