DJANGO_SETTINGS_MODULE=config.settings.production
TRACE_STORAGE_ROOT=/var/lib/trace
# Generate a private random value; blank fails closed.
TRACE_SECRET_KEY=
TRACE_ALLOWED_HOSTS=trace.example.internal
TRACE_CSRF_TRUSTED_ORIGINS=https://trace.example.internal
TRACE_TRUST_PROXY=1
TRACE_PROXY_IP=127.0.0.1
TRACE_BIND_HOST=127.0.0.1
TRACE_BIND_PORT=8000
TRACE_DB_ENGINE=sqlite

# Evidence quotas / available-space reserves (bytes); zero quota blocks uploads.
TRACE_EVIDENCE_ENGAGEMENT_QUOTA_BYTES=5368709120
TRACE_EVIDENCE_TOTAL_QUOTA_BYTES=21474836480
TRACE_STORAGE_MIN_FREE_BYTES=1073741824
TRACE_STORAGE_WARNING_PERCENT=20
TRACE_UPLOAD_TEMP_MIN_FREE_BYTES=16777216
